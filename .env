# OmniAgent AI Environment Variables (100% Free & Open Source)

# Application Settings
PROJECT_NAME="OmniAgent AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="omniagent-ai-super-secret-production-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite)
DATABASE_URL="sqlite+aiosqlite:///./omniagent.db"

# Free LLM & Embedding Settings
DEFAULT_LLM_PROVIDER="ollama"
DEFAULT_LLM_MODEL="qwen3"
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_TOP_P=0.95

# Ollama Server URL
OLLAMA_BASE_URL="http://localhost:11434"

# Fallback Cloud Model (Google Gemini Free API - Only when explicitly enabled)
ENABLE_CLOUD_GEMINI=False
GEMINI_API_KEY=""

# Storage Directories
UPLOAD_DIR="./backend/uploads"
CHROMA_DIR="./backend/chroma_db"
LOG_DIR="./backend/logs"
