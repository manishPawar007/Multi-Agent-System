# OmniAgent AI Production Environment Variables Template

# Application Settings
PROJECT_NAME="OmniAgent AI"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api/v1"
SECRET_KEY="YOUR_SUPER_SECRET_PRODUCTION_KEY_CHANGE_THIS"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite / PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./omniagent.db"

# LLM & Embedding Settings
DEFAULT_LLM_PROVIDER="ollama"
DEFAULT_LLM_MODEL="llama3.2:latest"
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"
DEFAULT_TEMPERATURE=0.7

# Local Ollama URL (Default: http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"

# Optional Cloud LLM Fallback (Google Gemini)
ENABLE_CLOUD_GEMINI=False
GEMINI_API_KEY=""

# Storage Directories
UPLOAD_DIR="./backend/uploads"
CHROMA_DIR="./backend/chroma_db"
LOG_DIR="./backend/logs"
